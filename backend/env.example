# Environment Configuration for EasyAPI CRUD Demo
# Copy this file to .env and update the values

# Application Environment
APP_ENV=production

# Database Configuration
# Update with your actual database credentials
DATABASE_URL=postgresql+asyncpg://easyapi_user:your_secure_password@localhost/easyapi_crud

# Alternative with schema specification (if using custom schema)
# DATABASE_URL=postgresql+asyncpg://easyapi_user:your_secure_password@localhost/easyapi_crud?options=-csearch_path%3Deasyapi

# CORS Configuration
# Update with your actual domain(s)
ALLOWED_ORIGINS=http://your-domain.com,https://your-domain.com,http://localhost:3000

# Optional: Additional settings
# SECRET_KEY=your-secret-key-here
# DEBUG=false
# LOG_LEVEL=info
