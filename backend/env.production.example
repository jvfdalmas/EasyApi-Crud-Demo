# Production Environment Configuration
# Copy this file to .env and update the values for your production environment

# Application environment
APP_ENV=production

# Database configuration
# For SQLite (development/small production)
DATABASE_URL=sqlite+aiosqlite:///./app.db

# For PostgreSQL (recommended for production)
# DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/easyapi_crud

# CORS allowed origins (comma-separated)
# Update with your actual domain(s)
ALLOWED_ORIGINS=http://your-domain.com,https://your-domain.com,http://localhost

# Optional: Additional configuration
# SECRET_KEY=your-secret-key-here
# DEBUG=false
