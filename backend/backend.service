[Unit]
Description=EasyAPI CRUD Backend
After=network.target

[Service]
Type=exec
User=www-data
Group=www-data
WorkingDirectory=/var/www/easyapi-crud-demo/backend
Environment=PATH=/var/www/easyapi-crud-demo/backend/venv/bin
Environment=DATABASE_URL=sqlite+aiosqlite:///./app.db
Environment=APP_ENV=production
Environment=ALLOWED_ORIGINS=http://your-domain.com,https://your-domain.com
ExecStart=/var/www/easyapi-crud-demo/backend/venv/bin/gunicorn app.main:app -w 4 -k uvicorn.workers.UvicornWorker -b 127.0.0.1:8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
